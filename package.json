{
  "name": "dsh-pet",
  "version": "0.4.1",
  "private": false,
  "description": "DSH 智能伙伴浮层：常驻桌面的 petdex 宠物，显示对话进展、任务结束提醒、全屏拖动、就地输入",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    "./client": "./src/client.js",
    ".": "./src/index.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "native",
    "locale",
    "tools",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs/previews"
  ],
  "engines": {
    "node": ">=22.6.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "pet",
    "petdex",
    "desktop-companion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KINGs74/dsh-pet.git"
  },
  "homepage": "https://github.com/KINGs74/dsh-pet#readme",
  "bugs": {
    "url": "https://github.com/KINGs74/dsh-pet/issues"
  },
  "author": "KINGs74"
}
